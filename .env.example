# Deixe vazio em desenvolvimento: o Vite repassa /api para o backend local (porta 3333).
# Só preencha se o backend estiver em outro domínio (ex.: deploy do front na Vercel):
# VITE_API_URL=https://seu-dominio.ngrok-free.app/api
VITE_API_URL=

# Opcional: outro endereço para o proxy /api do Vite (dev e preview)
# API_PROXY_TARGET=http://localhost:3333

# Domínio estático do ngrok para `npm run homolog` (front + /api numa URL só)
# NGROK_DOMAIN=seu-dominio.ngrok-free.dev
